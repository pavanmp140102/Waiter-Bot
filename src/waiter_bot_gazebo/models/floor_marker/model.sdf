<?xml version="1.0"?>
<!-- Flat disc on the floor with no collision. Marks a target location for the demo. Radius 0.25 m. -->
<sdf version="1.9">
  <model name="floor_marker">
    <static>true</static>
    <link name="disc">
      <pose>0 0 0.005 0 0 0</pose>
      <visual name="disc_visual">
        <geometry><cylinder><radius>0.25</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.7 0.3 1</ambient><diffuse>0.1 0.7 0.3 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
